#!/usr/bin/env php
<?php

declare(strict_types=1);

foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

exit((new Watcher\Cli\Application(
    // Under --json stdout is one JSON line, so the dry-run digest and estimate go to stderr.
    static fn (array $config, Watcher\Operate\RunOptions $options): callable => Watcher\Watcher::fromConfig(
        $config,
        new Watcher\Cli\StderrLogger(STDERR),
        null,
        $options,
        static fn (string $text): int|false => fwrite($options->json ? STDERR : STDOUT, $text),
    )->run(...),
    STDERR,
    STDOUT,
    static fn (array $config, bool $postTest): Watcher\Operate\CheckReport => Watcher\Config\Factory::doctor($config)->run($postTest),
    static fn (array $config): Watcher\Operate\HeartbeatStatus => Watcher\Config\Factory::heartbeatStatus($config, null, new Watcher\Cli\StderrLogger(STDERR)),
    static function (string $path, Watcher\Operate\RunOptions $options, array $only): callable {
        $runner = Watcher\Fleet\FleetRunner::fromConfig(
            $path,
            new Watcher\Cli\StderrLogger(STDERR),
            null,
            static fn (string $text): int|false => fwrite($options->json ? STDERR : STDOUT, $text),
        );

        return static fn (?DateTimeImmutable $now): Watcher\Fleet\FleetResult => $runner->run($now, $options, $only);
    },
    static fn (string $path, bool $postTest): Watcher\Operate\CheckReport => Watcher\Fleet\FleetCheck::fromConfig($path)->run($postTest),
    static fn (string $path): Watcher\Fleet\FleetStatus => Watcher\Fleet\FleetStatus::fromConfig($path, null, new Watcher\Cli\StderrLogger(STDERR)),
))->run($argv));
