#!/usr/bin/env bash
# Pre-commit: refuse ignored/secret files and secret-looking additions, then lint staged PHP.
# Install: scripts/install-hooks.sh (copies this file to .git/hooks; touches no git config).
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1
fail=0
staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

# 1. Force-added files that .gitignore says must not be tracked.
ignored=$(printf '%s\n' "$staged" | git check-ignore --no-index --stdin 2>/dev/null)
if [ -n "$ignored" ]; then
  echo "pre-commit: staged files match .gitignore (git add -f?):" >&2; printf '  %s\n' $ignored >&2; fail=1
fi

# 2. Files that never belong in the repo, even if .gitignore is edited.
bad=$(printf '%s\n' "$staged" | grep -E '(^|/)(\.env(\..*)?|auth\.json|id_rsa|id_ed25519)$|\.(pem|key|p12)$|(^|/)vendor/|\.DS_Store$|settings\.local\.json$' | grep -v '\.env\.example$')
if [ -n "$bad" ]; then
  echo "pre-commit: forbidden files staged:" >&2; printf '  %s\n' $bad >&2; fail=1
fi

# 3. Secret-looking added lines outside tests/, docs/ and specs/ (fixtures there are synthetic).
scan=$(printf '%s\n' "$staged" | grep -vE '^(tests|docs|specs|\.specify)/' )
if [ -n "$scan" ]; then
  hits=$(git diff --cached -U0 -- $scan | grep -E '^\+[^+]' | grep -E 'sk-ant-[A-Za-z0-9_-]{20,}|AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}|glpat-[A-Za-z0-9_-]{15,}|xox[abprs]-[A-Za-z0-9-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|AIza[0-9A-Za-z_-]{35}')
  if [ -n "$hits" ]; then
    echo "pre-commit: secret-looking text in staged changes (redacted):" >&2
    printf '%s\n' "$hits" | cut -c1-40 | sed 's/$/.../' >&2; fail=1
  fi
fi

# 4. Style of staged PHP files (fast); full phpstan/phpunit run in CI and by hand.
php_files=$(printf '%s\n' "$staged" | grep -E '\.php$')
if [ -n "$php_files" ] && [ -x vendor/bin/pint ]; then
  # shellcheck disable=SC2086
  vendor/bin/pint --test $php_files >/dev/null 2>&1 || { echo "pre-commit: pint failed; run: vendor/bin/pint" >&2; fail=1; }
fi

exit $fail
