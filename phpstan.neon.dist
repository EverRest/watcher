parameters:
    level: 8
    paths:
        - src
        - tests
    scanFiles:
        - scripts/badges.php
    excludePaths:
        - tests/Fixtures
    ignoreErrors:
        # Deliberate runtime guard: the phpdoc says list<RedactedGroup>, but the privacy boundary must not rely on a doc
        # (CorrelatorTest feeds it a non-RedactedGroup and expects the TypeError).
        -
            identifier: instanceof.alwaysTrue
            path: src/Fleet/Correlator.php
            count: 1
        # Lumen's application has no basePath() although the declared type (Laravel's contract) says it does; the
        # method_exists check is what keeps the adapter loadable on Lumen.
        -
            identifier: function.alreadyNarrowedType
            path: src/Laravel/WatcherServiceProvider.php
            count: 1
        # The provider type-hints Laravel's Application contract; the test hands it the bare container (the only part of the
        # contract register() uses), which is a real Container but not an Application.
        -
            identifier: argument.type
            path: tests/Unit/Laravel/WatcherServiceProviderTest.php
            count: 1
        # Retry::carriesResponse: hasResponse() exists on Guzzle 7 only and is reached only when ResponseException (8) does not exist.
        # Reported only when analysed against Guzzle 8 (no such method there), hence reportUnmatched: false.
        -
            identifier: method.notFound
            path: src/Source/Retry.php
            reportUnmatched: false
        # KubeApi: ConnectException::getHandlerContext() exists on Guzzle 7 only; the method_exists check keeps Guzzle 8 working.
        # Reported only when analysed against Guzzle 7 (always true there), hence reportUnmatched: false.
        -
            identifier: function.alreadyNarrowedType
            path: src/Source/Kubernetes/KubeApi.php
            reportUnmatched: false
