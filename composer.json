{
    "name": "everrest/watcher",
    "description": "Scheduled, model-routed log analysis that reports problems to Slack.",
    "type": "library",
    "license": "MIT",
    "keywords": ["log-analysis", "observability", "monitoring", "loki", "datadog", "anthropic", "claude", "llm", "slack", "telegram", "discord", "laravel", "lumen"],
    "homepage": "https://github.com/EverRest/watcher",
    "authors": [{ "name": "EverRest", "homepage": "https://github.com/EverRest" }],
    "support": {
        "issues": "https://github.com/EverRest/watcher/issues",
        "source": "https://github.com/EverRest/watcher"
    },
    "require": {
        "php": "^8.2",
        "anthropic-ai/sdk": "^1.1",
        "guzzlehttp/guzzle": "^7.15.2 || ^8.3",
        "php-http/discovery": "^1.12",
        "psr/clock": "^1.0",
        "psr/log": "^2.0 || ^3.0"
    },
    "require-dev": {
        "brianium/paratest": "^7.3.2",
        "illuminate/console": "^10.0 || ^11.0",
        "illuminate/support": "^10.0 || ^11.0",
        "laravel/pint": "^1.13",
        "phpstan/phpstan": "^1.11",
        "phpunit/phpunit": "^10.5 || ^11.0",
        "vlucas/phpdotenv": "^5.7"
    },
    "suggest": {
        "ext-intl": "NFKC folding of look-alike characters before redaction (optional; a small fallback covers fullwidth ASCII)",
        "ext-redis": "Redis state store",
        "ext-pdo": "PDO state store",
        "illuminate/support": "Lumen/Laravel adapter"
    },
    "autoload": { "psr-4": { "Watcher\\": "src/" } },
    "autoload-dev": { "psr-4": { "Watcher\\Tests\\": "tests/" } },
    "bin": ["bin/watcher"],
    "config": {
        "allow-plugins": { "php-http/discovery": false },
        "platform": { "php": "8.2.99" },
        "sort-packages": true
    },
    "scripts": {
        "test": "paratest",
        "test:serial": "phpunit",
        "coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "paratest --coverage-cobertura=build/coverage/cobertura.xml --coverage-clover=build/coverage/clover.xml --coverage-html=build/coverage/html --coverage-text=build/coverage/summary.txt"
        ],
        "stan": "phpstan analyse --memory-limit=512M",
        "style": "pint --test",
        "ci": ["@style", "@stan", "@test"]
    },
    "extra": {
        "branch-alias": { "dev-main": "0.1.x-dev" },
        "laravel": { "providers": ["Watcher\\Laravel\\WatcherServiceProvider"] }
    },
    "minimum-stability": "stable"
}
