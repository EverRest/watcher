# Copy to a path outside the repo (e.g. ~/watcher-smoke.env), chmod 600, then:
#   set -a; . ~/watcher-smoke.env; set +a
#   scripts/smoke-check.sh

WATCHER_ENABLED=1
WATCHER_SERVICE=orders-api
WATCHER_LOKI_URL=https://grafana.example.com/api/datasources/proxy/uid/REPLACE_ME
WATCHER_LOKI_TOKEN=REPLACE_ME
WATCHER_ANTHROPIC_KEY=REPLACE_ME
WATCHER_SLACK_WEBHOOK=https://hooks.slack.com/services/REPLACE_ME
WATCHER_MODEL_TRIAGE=REPLACE_ME
WATCHER_MODEL_ANALYZE=REPLACE_ME
WATCHER_MODEL_ESCALATE=REPLACE_ME
WATCHER_PRICE_TRIAGE_IN=REPLACE_ME
WATCHER_PRICE_TRIAGE_OUT=REPLACE_ME
WATCHER_PRICE_ANALYZE_IN=REPLACE_ME
WATCHER_PRICE_ANALYZE_OUT=REPLACE_ME
WATCHER_PRICE_ESCALATE_IN=REPLACE_ME
WATCHER_PRICE_ESCALATE_OUT=REPLACE_ME
WATCHER_STATE_PATH=/tmp/watcher-smoke
WATCHER_SERVICE_CONTEXT=One or two sentences describing the service under test.
