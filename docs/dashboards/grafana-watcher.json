    {
      "id": 14,
      "type": "logs",
      "title": "Top groups",
      "description": "Counts and fingerprints only; no log text.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "{$stream} | json | event_type=\"group\" | rank <= 10 | service=~\"$service\" | environment=~\"$environment\" | line_format \"#{{.rank}} {{.fingerprint}} {{.level}} {{.trend}} {{.count}}x (was {{.previous_count}})\"",
          "refId": "A",
          "legendFormat": "",
          "queryType": "range"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 15,
      "type": "logs",
      "title": "Findings (needs include_text on the sink)",
      "description": "Without include_text the text fields are absent and the line shows severity and counts only.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "{$stream} | json | event_type=\"finding\" | service=~\"$service\" | environment=~\"$environment\" | line_format \"{{.severity}} {{.title}} ({{.group_count}}x, {{.group_trend}}) check: {{.check}}\"",
          "refId": "A",
          "legendFormat": "",
          "queryType": "range"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
